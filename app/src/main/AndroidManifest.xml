<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.MyApplication">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Open supported platform links in vidspy: listed hosts come from the backend
                 registry (backend/vidspy_backend/platforms.py domains), kept in sync by
                 tests/test_backend.py::test_manifest_opens_every_platform_domain.
                 "*.host" also matches the bare host, so subdomains like vm.tiktok.com work. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*.instagram.com" />
                <data android:host="*.instagr.am" />
                <data android:host="*.tiktok.com" />
                <data android:host="*.linkedin.com" />
                <data android:host="*.lnkd.in" />
                <data android:host="*.youtube.com" />
                <data android:host="*.youtu.be" />
                <data android:host="*.youtube-nocookie.com" />
                <data android:host="*.twitter.com" />
                <data android:host="*.x.com" />
                <data android:host="*.t.co" />
                <data android:host="*.facebook.com" />
                <data android:host="*.fb.watch" />
                <data android:host="*.fb.com" />
                <data android:host="*.reddit.com" />
                <data android:host="*.redd.it" />
                <data android:host="*.pinterest.com" />
                <data android:host="*.pinterest.co.uk" />
                <data android:host="*.pinterest.de" />
                <data android:host="*.pinterest.fr" />
                <data android:host="*.pinterest.ca" />
                <data android:host="*.pin.it" />
                <data android:host="*.twitch.tv" />
                <data android:host="*.snapchat.com" />
                <data android:host="*.imgur.com" />
                <data android:host="*.imgur.io" />
                <data android:host="*.tumblr.com" />
                <data android:host="*.tmblr.co" />
                <data android:host="*.dailymotion.com" />
                <data android:host="*.dai.ly" />
                <data android:host="*.vimeo.com" />
                <data android:host="*.1hd.one" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:label="Linked accounts" />
    </application>

</manifest>